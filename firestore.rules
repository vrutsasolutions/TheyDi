rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    match /otps/{email} {
      allow read, write, delete: if true;
    }

    match /usernames/{username} {
      allow read: if true;
allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
allow update: if isAuth() && resource.data.uid == request.auth.uid;
allow delete: if isAuth() && resource.data.uid == request.auth.uid;
      match /friends/{friendId} {
        allow read: if isAuth();
        allow create, update, delete: if isAuth() && (request.auth.uid == userId || request.auth.uid == friendId);
      }

      match /friendRequests/{requestId} {
        allow read: if isAuth();
        allow create, update, delete: if isAuth();
      }

      match /blocked/{blockedUid} {
        allow read, write: if isOwner(userId);
      }

      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow create: if isAuth();
        allow update, delete: if isOwner(userId);
      }
    }

    match /events/{eventId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
allow delete: if isAuth() && (
  resource.data.creatorUid == request.auth.uid ||
  resource.data.organizerUid == request.auth.uid
);

match /attendees/{userId} {
  allow read: if isAuth();
  allow create, update, delete: if isAuth() &&
      request.auth.uid == userId;
}

match /attendeePayments/{userId} {
  allow read: if isAuth();
  allow create, update: if isAuth() &&
      request.auth.uid == userId;
  allow delete: if false;
}

// pendingMeta subcollection for tracking join requests
match /pendingMeta/{uid} {
  allow read: if isAuth();
  allow create, update, delete: if isAuth() && (
    request.auth.uid == uid ||
    request.auth.uid ==
        get(/databases/$(database)/documents/events/$(eventId))
            .data
            .creatorUid
  );
}
      match /reviews/{reviewId} {
        allow read: if isAuth();
        allow create: if isAuth() && request.auth.uid == request.resource.data.reviewerUid;
        allow update, delete: if isAuth() && resource.data.reviewerUid == request.auth.uid;
      }
    }

    match /{path=**}/reviews/{reviewId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.auth.uid == request.resource.data.reviewerUid;
      allow update, delete: if isAuth() && resource.data.reviewerUid == request.auth.uid;
    }

    match /reviews/{reviewId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.auth.uid == request.resource.data.reviewerUid;
      allow update, delete: if isAuth() && resource.data.reviewerUid == request.auth.uid;
    }

    match /bookings/{bookingId} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        resource.data.hostUid == request.auth.uid ||
        resource.data.organizerUid == request.auth.uid ||
        resource.data.creatorUid == request.auth.uid
      );
      allow create: if isAuth();
      allow update: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        resource.data.hostUid == request.auth.uid ||
        resource.data.organizerUid == request.auth.uid ||
        resource.data.creatorUid == request.auth.uid
      );
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    match /circles/{circleId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && (resource.data.creatorUid == request.auth.uid || request.auth.uid in resource.data.memberUids);
      allow delete: if isAuth() && resource.data.creatorUid == request.auth.uid;

      match /messages/{messageId} {
allow read, write: if isCircleMember(circleId);
      }

      match /clearedBy/{userId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /friend_requests/{requestId} {
      allow create: if isAuth() && request.resource.data.fromUid == request.auth.uid;
      allow read: if isAuth() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow update: if isAuth() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid) && request.resource.data.fromUid == resource.data.fromUid && request.resource.data.toUid == resource.data.toUid;
      allow delete: if isAuth() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    
    // ── CHATS (DMs) ───────────────────────────────────────────────────────────



    match /chats/{chatId} {
      allow read, create, update: if isAuth();
      allow delete: if false;

      match /messages/{messageId} {
        allow read, write: if isAuth();
      }

      match /clearedBy/{userId} {
        allow read, write: if isOwner(userId);
      }

      match /mutedBy/{userId} {
        allow read, write: if isAuth();
      }

      match /deletedBy/{userId} {
        allow read, write: if isAuth();
      }
    }

    match /notifications/{notificationId} {
      allow read: if isAuth() && resource.data.toUid == request.auth.uid;
      allow create: if isAuth();
      allow update, delete: if isAuth() && resource.data.toUid == request.auth.uid;
    }

    match /host_stats/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /voice_messages/{messageId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow delete: if isAuth() && resource.data.senderUid == request.auth.uid;
    }

    match /reports/{reportId} {
      allow create: if isAuth();
      allow read: if isAuth() && resource.data.reporterUid == request.auth.uid;
      allow update, delete: if false;
    }




  }
}