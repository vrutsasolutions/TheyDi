rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function isChatParticipant(chatId) {
      return isAuth() &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    function isCircleMember(circleId) {
      return isAuth() &&
        request.auth.uid in get(/databases/$(database)/documents/circles/$(circleId)).data.memberUids;
    }

    function isAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function hasReferralFields(data) {
      return data.keys().hasAny([
        'referralCode',
        'referralCodeCreatedAt',
        'referredBy',
        'referredByUid',
        'referredByCode',
        'referralAttributedAt',
        'referralCount'
      ]);
    }

    function changesReferralFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'referralCode',
        'referralCodeCreatedAt',
        'referredBy',
        'referredByUid',
        'referredByCode',
        'referralAttributedAt',
        'referralCount'
      ]);
    }

    match /otps/{email} {
      allow read, write, delete: if true;
    }

    match /usernames/{username} {
      allow read: if true;
      allow create: if isAuth();
      allow update, delete: if isAuth() && resource.data.uid == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if isAuth() &&
        request.auth.uid == userId &&
        !hasReferralFields(request.resource.data);
      allow update: if isAuth() && (
        (request.auth.uid == userId && !changesReferralFields()) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avgRating', 'totalReviews']) ||
        isAdmin()
      );
      allow delete: if isAuth() && request.auth.uid == userId;

      match /private/{document=**} {
        allow read, write: if isOwner(userId);
      }

      match /friends/{friendId} {
        allow read, write: if isAuth();
      }

      match /friendRequests/{requestId} {
        allow read, create, update, delete: if isAuth();
      }

      match /sentFriendRequests/{requestId} {
        allow read, create, update, delete: if isAuth();
      }

      match /blocked/{blockedUid} {
        allow read, write: if isOwner(userId);
      }

      match /notifications/{notifId} {
        allow read: if isOwner(userId);
        allow create: if isAuth() && (
          isOwner(userId) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
        );
        allow update, delete: if isOwner(userId);
      }

      match /communityRequests/{communityId} {
        allow read, write: if isOwner(userId);
      }

      match /activityLog/{logId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /events/{eventId} {
      allow read: if true;
  allow create: if isAuth();
  allow update: if isAuth();
  allow delete: if isAuth() && (
    resource.data.creatorUid == request.auth.uid ||
    resource.data.organizerUid == request.auth.uid
  );

      match /attendees/{userId} {
        allow read: if isAuth();
        allow write: if isOwner(userId);
      }

      match /attendeePayments/{userId} {
        allow read: if isAuth();
        allow create, update: if isAuth() && request.auth.uid == userId;
        allow delete: if false;
      }

      match /pendingMeta/{uid} {
        allow read: if isAuth();
        allow write: if isAuth() && (
          request.auth.uid == uid ||
          request.auth.uid == get(/databases/$(database)/documents/events/$(eventId)).data.creatorUid
        );
      }

      match /reviews/{reviewId} {
        allow read: if isAuth();
        allow create: if isAuth();
        allow update, delete: if isAuth() &&
          resource.data.reviewerUid == request.auth.uid;
      }
    }

    match /{path=**}/reviews/{reviewId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.auth.uid == request.resource.data.reviewerUid;
      allow update, delete: if isAuth() && resource.data.reviewerUid == request.auth.uid;
    }

    match /reviews/{reviewId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.auth.uid == request.resource.data.reviewerUid;
      allow update, delete: if isAuth() && resource.data.reviewerUid == request.auth.uid;
    }

    match /bookings/{bookingId} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        resource.data.hostUid == request.auth.uid ||
        resource.data.organizerUid == request.auth.uid ||
        resource.data.creatorUid == request.auth.uid
      );
      allow create: if isAuth();
      allow update: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        resource.data.hostUid == request.auth.uid ||
        resource.data.organizerUid == request.auth.uid ||
        resource.data.creatorUid == request.auth.uid
      );
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    match /circles/{circleId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && (
        resource.data.creatorUid == request.auth.uid ||
        request.auth.uid in resource.data.memberUids
      );
      allow delete: if isAuth() && resource.data.creatorUid == request.auth.uid;

      match /messages/{messageId} {
        allow read, write: if isCircleMember(circleId);
      }

      match /clearedBy/{userId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /communities/{communityId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.auth.uid == request.resource.data.creatorUid;
      allow update: if isAuth() && (
        resource.data.creatorUid == request.auth.uid ||
        request.auth.uid in resource.data.memberUids ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'memberNames'])
      );
      allow delete: if isAuth() && resource.data.creatorUid == request.auth.uid;

      match /messages/{messageId} {
        allow read, write: if isAuth() &&
          request.auth.uid in get(/databases/$(database)/documents/communities/$(communityId)).data.memberUids;
      }

      match /joinRequests/{uid} {
        allow read: if isAuth() && (
          request.auth.uid == uid ||
          request.auth.uid == get(/databases/$(database)/documents/communities/$(communityId)).data.creatorUid
        );
        allow create: if isAuth() && request.auth.uid == uid;
        allow delete: if isAuth() && (
          request.auth.uid == uid ||
          request.auth.uid == get(/databases/$(database)/documents/communities/$(communityId)).data.creatorUid
        );
      }

      match /clearedBy/{userId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /friend_requests/{requestId} {
      allow create: if isAuth() &&
        request.resource.data.fromUid == request.auth.uid;
      allow read: if isAuth() &&
        (resource.data.fromUid == request.auth.uid ||
         resource.data.toUid == request.auth.uid);
      allow update: if isAuth() &&
        (resource.data.fromUid == request.auth.uid ||
         resource.data.toUid == request.auth.uid) &&
        request.resource.data.fromUid == resource.data.fromUid &&
        request.resource.data.toUid == resource.data.toUid;
      allow delete: if isAuth() &&
        (resource.data.fromUid == request.auth.uid ||
         resource.data.toUid == request.auth.uid);
    }

    match /chats/{chatId} {
      allow read, create, update: if isAuth();
      allow delete: if false;

      match /messages/{messageId} {
        allow read, write: if isAuth();
      }

      match /clearedBy/{userId} {
        allow read, write: if isOwner(userId);
      }

      match /mutedBy/{userId} {
        allow read, write: if isAuth();
      }

      match /deletedBy/{userId} {
        allow read, write: if isAuth();
      }
    }

    match /notifications/{notificationId} {
      allow read: if isAuth() &&
        resource.data.toUid == request.auth.uid;
      allow create: if isAuth();
      allow update, delete: if isAuth() &&
        resource.data.toUid == request.auth.uid;
    }

    match /referralCodes/{code} {
      allow read: if true;
      allow write: if false;
    }

    match /referrals/{inviteeUid} {
      allow read: if isAuth() && (
        request.auth.uid == inviteeUid ||
        resource.data.referrerUid == request.auth.uid ||
        isAdmin()
      );
      allow write: if false;
    }

    match /host_stats/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /voice_messages/{messageId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow delete: if isAuth() &&
        resource.data.senderUid == request.auth.uid;
    }

    match /reports/{reportId} {
      allow create: if isAuth();
      allow read: if isAuth() && resource.data.reporterUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /verificationRequests/{userId} {
      allow read: if request.auth != null &&
        (request.auth.uid == userId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);
      allow write: if request.auth != null;
    }

    match /users/{userId}/notifications/{notifId} {
      allow create: if isAuth();
    }

    match /payouts/{payoutId} {
      allow read: if isAuth() && (
        isAdmin() ||
        resource.data.hostUid == request.auth.uid ||
        resource.data.creatorUid == request.auth.uid
      );
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Fee benefits are written only by Cloud Functions (Admin SDK bypasses
    // rules). Clients may read their own document but never change it.
    match /feeBenefits/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /refunds/{refundId} {
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}