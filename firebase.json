{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "theydi-cefdf",
          "appId": "1:703233514575:android:1cd925f3dc51bebccf1e3a",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "theydi-cefdf",
          "configurations": {
            "android": "1:703233514575:android:1cd925f3dc51bebccf1e3a",
            "web": "1:703233514575:web:cda2cf982e82c7efcf1e3a"
          }
        }
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "*.local"
    ]
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "emulators": {
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true,
      "port": 4000
    }
  }
}
